# ===== Admin 认证（Vercel / 本地 .env 中填写真实值，不要 commit）=====

# 管理员用户名（默认 admin；可自定义）
ADMIN_USERNAME=admin

# 管理员密码哈希（使用 scripts/hash-password.mjs 生成）
# 示例：ADMIN_PASSWORD_HASH=scrypt$N=16384,r=8,p=1$xxxx$yyyy
ADMIN_PASSWORD_HASH=

# JWT 签名密钥（至少 32 位随机十六进制 / ASCII，越长越好）
# 不要与任何第三方服务共享
ADMIN_JWT_SECRET=

# ===== GitHub 接入（Fine-grained PAT，最小权限：仓库 Contents R/W，仅限 myblog）=====

GITHUB_TOKEN=
GITHUB_OWNER=liushengxiong
GITHUB_REPO=myblog
GITHUB_BRANCH=main

# ===== 本地 / CI 烟雾测试（可选）=====
# 1 = 启用 GitHub 抽象层内存 MOCK，所有 Admin API 不写真实仓库
ADMIN_GITHUB_MOCK=0
