{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/posts\\/new\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/posts\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/posts\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/projects\\/new\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/projects\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/projects\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/settings\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/tools\\/new\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/tools\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/tools\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/admin\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/auth\\/csrf\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/auth\\/login\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/auth\\/logout\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/auth\\/me\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/dashboard\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/images\\/upload\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/images\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/posts\\/([^/]+?)\\/check\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/posts\\/([^/]+?)\\/publish\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/posts\\/([^/]+?)\\/unpublish\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/posts\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/posts\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/projects\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/projects\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/settings\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/tools\\/([^/]+?)\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/admin\\/tools\\/?$",
			"dest": "_render"
		}
	]
}