---
/**
 * 项目列表页（Task 5A.1b / Spec FR-6 / AC-5 / AC-6）
 *
 * 功能：
 *  - 服务端直读项目列表（listDataItems + PROJECT_SCHEMA）
 *  - 表格展示：排序、ID、名称（中/英）、状态、可见、操作
 *  - 上移/下移按钮 → PUT /api/admin/projects（原子重排）
 *  - 新增按钮 → /admin/projects/new
 *  - 编辑链接 → /admin/projects/[id]
 *  - 删除按钮（二次确认）
 */
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../../layouts/admin.astro";
import { getSession } from "../../../lib/auth";
import { listDataItems } from "../../../lib/data-items";
import { PREFIX_PROJECTS } from "../../../lib/github";
import { PROJECT_SCHEMA, type Project } from "../../../lib/schemas";

const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname + Astro.url.search);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;

let items: { id: string; path: string; sha: string; data: Project }[] = [];
let loadError = "";
try {
	const list = await listDataItems<Project>(PREFIX_PROJECTS, { schema: PROJECT_SCHEMA });
	list.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
	items = list.map((i) => ({ id: i.id, path: i.path, sha: i.sha, data: i.data }));
} catch (e) {
	loadError = e instanceof Error ? e.message : String(e);
}
---

<AdminLayout title="项目管理" username={username} active="projects">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-slate-600 dark:text-slate-300">
      项目列表用于控制首页“项目”展示。数据存储于 <code>src/content/projects/*.json</code>
    </p>
    <a
      href="/admin/projects/new"
      class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-4 py-3 text-sm font-medium text-white shadow hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
    >
      ＋ 新增项目
    </a>
  </div>

  {loadError && (
    <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-xs text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300">
      加载失败：{loadError}
    </div>
  )}

  <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs text-slate-500 dark:bg-slate-800/60 dark:text-slate-400">
        <tr>
          <th class="px-5 py-3 font-medium">排序</th>
          <th class="px-5 py-3 font-medium">ID</th>
          <th class="px-5 py-3 font-medium">名称</th>
          <th class="px-5 py-3 font-medium">状态</th>
          <th class="px-5 py-3 font-medium">可见</th>
          <th class="px-5 py-3 text-right font-medium">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-200" data-admin-projects-tbody>
        {items.length === 0 ? (
          <tr>
            <td colspan="6" class="px-5 py-10 text-center text-xs text-slate-500 dark:text-slate-400">
              暂无项目。点击右上角“＋ 新增项目”开始。
            </td>
          </tr>
        ) : items.map((p, idx) => (
          <tr
            data-admin-projects-row
            data-id={p.id}
            data-sha={p.sha}
            data-order={p.data.order ?? 0}
          >
            <td class="px-5 py-3">
              <div class="inline-flex flex-col gap-0.5">
                <button
                  type="button"
                  data-admin-projects-up
                  disabled={idx === 0}
                  class="rounded border border-slate-200 bg-white px-1.5 py-0.5 text-xs text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
                  title="上移"
                  aria-label="上移"
                >↑</button>
                <button
                  type="button"
                  data-admin-projects-down
                  disabled={idx === items.length - 1}
                  class="rounded border border-slate-200 bg-white px-1.5 py-0.5 text-xs text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
                  title="下移"
                  aria-label="下移"
                >↓</button>
              </div>
              <span class="ml-2 text-xs text-slate-400">#{p.data.order ?? 0}</span>
            </td>
            <td class="px-5 py-3 font-mono text-xs break-all">{p.id}</td>
            <td class="px-5 py-3">
              <div class="font-medium">{p.data.name?.zh || "(未命名)"}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">{p.data.name?.en}</div>
            </td>
            <td class="px-5 py-3 text-xs">
              <div>{p.data.status?.zh || "—"}</div>
              <div class="text-slate-500 dark:text-slate-400">{p.data.status?.en}</div>
            </td>
            <td class="px-5 py-3">
              {p.data.visible ? (
                <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-200">显示</span>
              ) : (
                <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">隐藏</span>
              )}
            </td>
            <td class="px-5 py-3 text-right text-xs">
              <a
                href={`/admin/projects/${encodeURIComponent(p.id)}`}
                class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              >
                编辑
              </a>
              <button
                type="button"
                data-admin-projects-delete
                data-id={p.id}
                data-sha={p.sha}
                class="ml-1 inline-flex items-center gap-1 rounded-md border border-red-200 bg-white px-2.5 py-1 text-red-700 hover:bg-red-50 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300 dark:hover:bg-red-900/40"
              >
                删除
              </button>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
  type AdminApi = {
    fetch: <T = unknown>(
      input: RequestInfo,
      init?: RequestInit & { expectCsrf?: boolean },
    ) => Promise<T>;
    toast: (msg: string, level?: "info" | "success" | "error" | "warn") => void;
  };
  const api = (window as unknown as { AdminApi: AdminApi }).AdminApi;

  type ProjectRow = { id: string; order: number };

  function collectOrder(): ProjectRow[] {
    const rows = document.querySelectorAll<HTMLTableRowElement>("[data-admin-projects-row]");
    const out: ProjectRow[] = [];
    rows.forEach((r, idx) => {
      out.push({ id: r.dataset.id || "", order: idx });
    });
    return out;
  }

  async function persistOrder() {
    const items = collectOrder();
    if (items.length === 0) return;
    try {
      await api.fetch("/api/admin/projects", {
        method: "PUT",
        body: JSON.stringify({ items }),
      });
      api.toast("排序已更新。", "success");
      setTimeout(() => window.location.reload(), 400);
    } catch {
      // toast 已在 apiFetch 中弹出
    }
  }

  function swapRows(a: HTMLTableRowElement, b: HTMLTableRowElement) {
    const parent = a.parentNode;
    if (!parent) return;
    parent.insertBefore(b, a);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-admin-projects-up]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = btn.closest<HTMLTableRowElement>("[data-admin-projects-row]");
      if (!row) return;
      const prev = row.previousElementSibling as HTMLTableRowElement | null;
      if (!prev || !prev.hasAttribute("data-admin-projects-row")) return;
      swapRows(row, prev);
      void persistOrder();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-admin-projects-down]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = btn.closest<HTMLTableRowElement>("[data-admin-projects-row]");
      if (!row) return;
      const next = row.nextElementSibling as HTMLTableRowElement | null;
      if (!next || !next.hasAttribute("data-admin-projects-row")) return;
      swapRows(next, row);
      void persistOrder();
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-admin-projects-delete]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.id;
      const sha = btn.dataset.sha;
      if (!id) return;
      const ok = window.confirm(`确认删除项目 "${id}"？\n\n此操作会立即在 GitHub 提交一次删除 commit，不可撤销。`);
      if (!ok) return;
      try {
        await api.fetch(`/api/admin/projects/${encodeURIComponent(id)}?sha=${encodeURIComponent(sha || "")}`, { method: "DELETE" });
        api.toast("已提交删除 commit，等待 Vercel 部署。", "success");
        btn.closest("tr")?.remove();
      } catch {
        // toast 已在 apiFetch 中弹出
      }
    });
  });
</script>
