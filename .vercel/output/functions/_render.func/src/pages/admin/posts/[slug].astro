---
/**
 * 编辑文章页（Task 3.2d / Spec FR-4 / AC-4）
 *
 * 功能：
 *  - 服务端读取文章（findPost + parseFrontmatter），表单预填
 *  - 已发布文章 slug 默认 disabled，带警告条
 *    "⚠ 修改 slug 会改变文章 URL，可能影响 SEO 和已有链接。"
 *    点击"解锁修改"后弹窗二次确认 → 启用输入框
 *  - 草稿文章 slug 可直接编辑（草稿无 URL 稳定性约束）
 *  - 状态切换（草稿 ↔ 已发布）通过 status 下拉 + PUT 触发跨目录原子 move
 *  - iframe sandbox 预览（同 new 页）
 *  - 删除按钮 / 发布草稿 / 取消发布按钮
 */
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../../layouts/admin.astro";
import { getSession } from "../../../lib/auth";
import { findPost } from "../../../lib/posts";
import { parseFrontmatter } from "../../../lib/markdown";
import { GitHubError } from "../../../lib/github";

const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname + Astro.url.search);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;

const slug = Astro.params.slug ?? "";
let notFound = false;
let serverError = "";
let title = "";
let description = "";
let dateFormatted = "";
let locale: "zh" | "en" = "zh";
let tags: string[] = [];
let featured = false;
let body = "";
let status: "draft" | "published" = "published";
let sha = "";
let path = "";

if (slug) {
	try {
		const found = await findPost(slug);
		if (!found) {
			notFound = true;
		} else {
			status = found.status;
			sha = found.info.sha;
			path = found.info.path;
			const r = parseFrontmatter(found.info.content);
			title = r.frontmatter.title;
			description = r.frontmatter.description;
			dateFormatted = r.frontmatter.dateFormatted;
			locale = r.frontmatter.locale;
			tags = r.frontmatter.tags ?? [];
			featured = r.frontmatter.featured;
			body = r.body;
		}
	} catch (e) {
		if (e instanceof GitHubError) {
			serverError = e.message;
		} else {
			serverError = e instanceof Error ? e.message : String(e);
		}
	}
} else {
	notFound = true;
}

const initial = {
	slug,
	title,
	description,
	dateFormatted,
	locale,
	tags,
	featured,
	body,
	status,
	sha,
	path,
};
const initialJson = JSON.stringify(initial);
---

<AdminLayout title={`编辑：${slug || "文章"}`} username={username} active="posts">
  <nav class="text-xs text-slate-500 dark:text-slate-400">
    <a href="/admin/posts/" class="hover:text-slate-700 dark:hover:text-slate-200">博客管理</a>
    <span class="mx-1">/</span>
    <span class="text-slate-700 dark:text-slate-200">{slug}</span>
  </nav>

  {notFound && (
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
      <div class="font-medium">文章未找到</div>
      <p class="mt-1 text-xs">slug "{slug}" 在 post/ 与 drafts/ 下都不存在。可能已被删除，或 slug 不正确。</p>
      <a href="/admin/posts/" class="mt-3 inline-flex rounded-md bg-amber-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-700">返回列表</a>
    </div>
  )}

  {serverError && !notFound && (
    <div class="rounded-xl border border-red-200 bg-red-50 p-6 text-sm text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200">
      <div class="font-medium">读取文章时出错</div>
      <p class="mt-1 text-xs font-mono break-all">{serverError}</p>
    </div>
  )}

  {!notFound && !serverError && (
    <form data-admin-post-form class="space-y-5" autocomplete="off">
      <!-- slug 锁定警告条（仅已发布文章显示） -->
      {status === "published" && (
        <div
          data-admin-post-slug-warning
          class="flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200"
        >
          <span class="text-base leading-none">⚠</span>
          <div class="flex-1">
            <div class="font-medium">已发布文章的 slug 默认锁定</div>
            <p class="mt-0.5">修改 slug 会改变文章 URL，可能影响 SEO 和已有链接。</p>
          </div>
          <button
            type="button"
            data-admin-post-slug-unlock
            class="shrink-0 rounded-md border border-amber-300 bg-white px-2.5 py-1 text-amber-700 hover:bg-amber-100 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-300 dark:hover:bg-amber-900/40"
          >
            解锁修改
          </button>
        </div>
      )}

      <!-- slug + 状态 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            Slug <span class="text-red-600">*</span>
            <span class="ml-1 text-slate-400 font-normal">（即文件名与公开 URL）</span>
          </label>
          <input
            type="text"
            name="slug"
            data-admin-post-slug
            required
            pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
            minlength="2"
            maxlength="120"
            value={slug}
            disabled={status === "published"}
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-mono outline-none focus:border-slate-400 disabled:bg-slate-50 disabled:text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:disabled:bg-slate-800 dark:disabled:text-slate-500"
          />
          <p data-admin-post-slug-hint class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            {status === "published" ? "已发布：slug 锁定，点击上方「解锁修改」可改（不推荐）。" : "草稿：可自由修改 slug（仍需唯一）。"}
          </p>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">状态</label>
          <select
            name="status"
            data-admin-post-status
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          >
            <option value="published" selected={status === "published"}>已发布（src/content/post/）</option>
            <option value="draft" selected={status === "draft"}>草稿（src/content/post/drafts/）</option>
          </select>
        </div>
      </div>

      <input type="hidden" data-admin-post-existing-sha value={sha} />
      <input type="hidden" data-admin-post-original-slug value={slug} />
      <input type="hidden" data-admin-post-original-status value={status} />

      <!-- 标题 -->
      <div>
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
          标题 <span class="text-red-600">*</span>
        </label>
        <input
          type="text"
          name="title"
          data-admin-post-title
          required
          maxlength="200"
          value={title}
          class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
        />
      </div>

      <!-- 描述 -->
      <div>
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
          描述 <span class="text-red-600">*</span>
        </label>
        <textarea
          name="description"
          data-admin-post-description
          required
          rows="2"
          maxlength="500"
          class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
        >{description}</textarea>
      </div>

      <!-- 日期 + 语言 + 标签 -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="md:col-span-2">
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            发布日期 <span class="text-red-600">*</span>
          </label>
          <input
            type="text"
            name="dateFormatted"
            data-admin-post-date
            required
            value={dateFormatted}
            placeholder="May 8, 2024"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">语言</label>
          <select
            name="locale"
            data-admin-post-locale
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          >
            <option value="zh" selected={locale === "zh"}>中文</option>
            <option value="en" selected={locale === "en"}>English</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            标签 <span class="text-slate-400 font-normal">（英文逗号分隔）</span>
          </label>
          <input
            type="text"
            name="tags"
            data-admin-post-tags
            value={tags.join(", ")}
            placeholder="AI, 个人品牌"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
      </div>

      <label class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200">
        <input
          type="checkbox"
          name="featured"
          data-admin-post-featured
          checked={featured}
          class="rounded border-slate-300 text-slate-900 focus:ring-slate-500 dark:border-slate-600 dark:bg-slate-900"
        />
        <span>精选文章（首页置顶）</span>
      </label>

      <!-- 正文 + 预览 -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-medium text-slate-700 dark:text-slate-200">
              正文（Markdown） <span class="text-red-600">*</span>
            </label>
            <div class="flex items-center gap-2">
              <button
                type="button"
                data-admin-post-insert-image
                class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
              >
                插入图片
              </button>
              <span class="text-xs text-slate-400">实时预览在右侧</span>
            </div>
          </div>
          <textarea
            name="body"
            data-admin-post-body
            required
            rows="22"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-mono outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          >{body}</textarea>
        </div>
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-medium text-slate-700 dark:text-slate-200">预览</label>
            <span class="text-xs text-slate-400">iframe sandbox 隔离</span>
          </div>
          <iframe
            data-admin-post-preview
            sandbox="allow-same-origin"
            srcdoc=""
            title="Markdown 预览"
            class="w-full h-[560px] rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-900"
          ></iframe>
        </div>
      </div>

      <!-- 元数据 -->
      <div class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-xs text-slate-600 dark:border-slate-800 dark:bg-slate-900/60 dark:text-slate-300">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <div><span class="text-slate-500 dark:text-slate-400">仓库路径：</span><code class="font-mono break-all">{path}</code></div>
          <div><span class="text-slate-500 dark:text-slate-400">当前 SHA：</span><code class="font-mono break-all">{sha.slice(0, 12)}…</code></div>
        </div>
      </div>

      <!-- 操作 -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <button
          type="submit"
          data-admin-post-submit
          class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white shadow hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
        >
          保存修改
        </button>
        {status === "draft" && (
          <button
            type="button"
            data-admin-post-publish
            class="inline-flex items-center gap-1 rounded-lg border border-emerald-300 bg-white px-4 py-2.5 text-sm font-medium text-emerald-700 hover:bg-emerald-50 dark:border-emerald-800 dark:bg-slate-900 dark:text-emerald-300 dark:hover:bg-emerald-950/40"
          >
            发布到公开站
          </button>
        )}
        {status === "published" && (
          <button
            type="button"
            data-admin-post-unpublish
            class="inline-flex items-center gap-1 rounded-lg border border-amber-300 bg-white px-4 py-2.5 text-sm font-medium text-amber-700 hover:bg-amber-50 dark:border-amber-800 dark:bg-slate-900 dark:text-amber-300 dark:hover:bg-amber-950/40"
          >
            移回草稿
          </button>
        )}
        <button
          type="button"
          data-admin-post-delete
          class="inline-flex items-center gap-1 rounded-lg border border-red-200 bg-white px-4 py-2.5 text-sm font-medium text-red-700 hover:bg-red-50 dark:border-red-900 dark:bg-slate-900 dark:text-red-300 dark:hover:bg-red-950/40"
        >
          删除文章
        </button>
        <a
          href="/admin/posts/"
          class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        >
          返回列表
        </a>
        <span data-admin-post-status-text class="text-xs text-slate-500 dark:text-slate-400"></span>
      </div>
    </form>
  )}

  <script type="application/json" data-admin-post-initial set:html={initialJson}></script>
</AdminLayout>

<script>
  import { renderMarkdown, wrapPreviewHtml } from "../../../lib/mini-markdown";

  type AdminApi = {
    fetch: <T = unknown>(
      input: RequestInfo,
      init?: RequestInit & { expectCsrf?: boolean },
    ) => Promise<T>;
    toast: (msg: string, level?: "info" | "success" | "error" | "warn") => void;
  };
  const api = (window as unknown as { AdminApi: AdminApi }).AdminApi;

  const form = document.querySelector<HTMLFormElement>("[data-admin-post-form]");
  if (!form) {
    // 文章未找到 / 出错页面，跳过脚本
  } else {
    const initial = JSON.parse(
      document.querySelector<HTMLScriptElement>("[data-admin-post-initial]")?.textContent || "{}",
    ) as {
      slug: string;
      title: string;
      description: string;
      dateFormatted: string;
      locale: string;
      tags: string[];
      featured: boolean;
      body: string;
      status: "draft" | "published";
      sha: string;
      path: string;
    };

    const slugInput = form.querySelector<HTMLInputElement>("[data-admin-post-slug]")!;
    const slugHint = form.querySelector<HTMLElement>("[data-admin-post-slug-hint]")!;
    const unlockBtn = form.querySelector<HTMLButtonElement>("[data-admin-post-slug-unlock]") ?? null;
    const titleInput = form.querySelector<HTMLInputElement>("[data-admin-post-title]")!;
    const descInput = form.querySelector<HTMLTextAreaElement>("[data-admin-post-description]")!;
    const dateInput = form.querySelector<HTMLInputElement>("[data-admin-post-date]")!;
    const localeSel = form.querySelector<HTMLSelectElement>("[data-admin-post-locale]")!;
    const tagsInput = form.querySelector<HTMLInputElement>("[data-admin-post-tags]")!;
    const featuredInput = form.querySelector<HTMLInputElement>("[data-admin-post-featured]")!;
    const bodyInput = form.querySelector<HTMLTextAreaElement>("[data-admin-post-body]")!;
    const statusSel = form.querySelector<HTMLSelectElement>("[data-admin-post-status]")!;
    const existingShaInput = form.querySelector<HTMLInputElement>("[data-admin-post-existing-sha]")!;
    const originalSlugInput = form.querySelector<HTMLInputElement>("[data-admin-post-original-slug]")!;
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-admin-post-submit]")!;
    const statusText = form.querySelector<HTMLElement>("[data-admin-post-status-text]")!;
    const previewIframe = form.querySelector<HTMLIFrameElement>("[data-admin-post-preview]")!;
    const deleteBtn = form.querySelector<HTMLButtonElement>("[data-admin-post-delete]")!;
    const publishBtn = form.querySelector<HTMLButtonElement>("[data-admin-post-publish]") ?? null;
    const unpublishBtn = form.querySelector<HTMLButtonElement>("[data-admin-post-unpublish]") ?? null;

    const SLUG_REGEX = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

    // ====== slug 解锁（仅已发布文章） ======
    if (unlockBtn) {
      unlockBtn.addEventListener("click", () => {
        const confirmed = window.confirm(
          "确定要修改 slug 吗？\n\n修改 slug 会改变文章 URL，可能影响 SEO 和已有外部链接。\n旧 URL 将不再可访问。\n\n如确需修改，请确保已设置重定向。",
        );
        if (confirmed) {
          slugInput.disabled = false;
          slugInput.focus();
          slugHint.textContent = "⚠ slug 已解锁。修改后会触发跨目录原子 move（delete + create）。";
          slugHint.className = "mt-1 text-xs text-amber-600 dark:text-amber-400";
          unlockBtn.style.display = "none";
        }
      });
    }

    // ====== slug 冲突检测（仅当 slug 与原值不同时） ======
    let slugCheckTimer: ReturnType<typeof setTimeout> | null = null;
    function scheduleSlugCheck() {
      if (slugCheckTimer) clearTimeout(slugCheckTimer);
      slugCheckTimer = setTimeout(async () => {
        const v = slugInput.value.trim();
        if (v === initial.slug) {
          slugHint.textContent = "✓ slug 与原值一致，不会触发 move。";
          slugHint.className = "mt-1 text-xs text-emerald-600 dark:text-emerald-400";
          return;
        }
        if (!SLUG_REGEX.test(v) || v.length < 2 || v.length > 120) {
          slugHint.textContent = "slug 格式非法：仅小写字母/数字/连字符，2-120 字符。";
          slugHint.className = "mt-1 text-xs text-red-600 dark:text-red-400";
          return;
        }
        try {
          const r = await api.fetch<{ exists: boolean; status: string | null }>(
            `/api/admin/posts/${encodeURIComponent(v)}/check`,
            { method: "POST", body: JSON.stringify({}), expectCsrf: false },
          );
          if (r.exists) {
            slugHint.textContent = `slug 已被占用（状态：${r.status}）。请换一个。`;
            slugHint.className = "mt-1 text-xs text-amber-600 dark:text-amber-400";
          } else {
            slugHint.textContent = `✓ 新 slug 可用。保存时将删除旧文件并创建新文件（单次 commit）。`;
            slugHint.className = "mt-1 text-xs text-emerald-600 dark:text-emerald-400";
          }
        } catch {
          // toast 已在 apiFetch 中弹出
        }
      }, 350);
    }
    if (!slugInput.disabled) {
      slugInput.addEventListener("input", scheduleSlugCheck);
    }
    // 解锁后也监听
    if (unlockBtn) {
      unlockBtn.addEventListener("click", () => {
        slugInput.addEventListener("input", scheduleSlugCheck);
      });
    }

    // ====== 插入图片（图片选择器 Modal） ======
    const insertImageBtn = form.querySelector<HTMLButtonElement>("[data-admin-post-insert-image]");
    if (insertImageBtn) {
      insertImageBtn.addEventListener("click", async () => {
        const { openImagePicker } = await import("../../../lib/image-picker");
        openImagePicker({
          title: "插入图片到正文",
          confirmText: "插入",
          onPick: (url) => {
            // 在光标处插入 ![alt](url)
            const start = bodyInput.selectionStart;
            const end = bodyInput.selectionEnd;
            const before = bodyInput.value.slice(0, start);
            const after = bodyInput.value.slice(end);
            const alt = "图片";
            const snippet = `![${alt}](${url})`;
            bodyInput.value = before + snippet + after;
            const newCursor = before.length + snippet.length;
            bodyInput.focus();
            bodyInput.setSelectionRange(newCursor, newCursor);
            bodyInput.dispatchEvent(new Event("input"));
            api.toast(`已插入图片：${url}`, "success");
          },
        });
      });
    }

    // ====== iframe sandbox 预览（防抖） ======
    let previewTimer: ReturnType<typeof setTimeout> | null = null;
    function renderPreview() {
      if (previewTimer) clearTimeout(previewTimer);
      previewTimer = setTimeout(() => {
        const md = bodyInput.value;
        const html = wrapPreviewHtml(renderMarkdown(md));
        previewIframe.srcdoc = html;
      }, 200);
    }
    bodyInput.addEventListener("input", renderPreview);
    renderPreview();

    // ====== 收集表单数据 ======
    function collectPayload() {
      const tags = tagsInput.value
        .split(/[,，]/)
        .map((s) => s.trim())
        .filter(Boolean);
      return {
        slug: slugInput.value.trim(),
        title: titleInput.value.trim(),
        description: descInput.value.trim(),
        dateFormatted: dateInput.value.trim(),
        locale: localeSel.value as "zh" | "en",
        tags,
        featured: featuredInput.checked,
        body: bodyInput.value,
        status: statusSel.value as "draft" | "published",
        existingSha: existingShaInput.value,
      };
    }

    // ====== 保存（PUT） ======
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const originalSlug = originalSlugInput.value;
      const payload = collectPayload();
      if (!SLUG_REGEX.test(payload.slug) || payload.slug.length < 2) {
        api.toast("slug 格式非法，请检查。", "warn");
        slugInput.focus();
        return;
      }
      if (!payload.title || !payload.description || !payload.dateFormatted || !payload.body) {
        api.toast("请填写所有必填字段。", "warn");
        return;
      }
      submitBtn.setAttribute("disabled", "true");
      statusText.textContent = "正在提交到 GitHub…";
      try {
        const res = await api.fetch<{ ok: boolean; slug: string; status: string; path: string; sha: string; moved: boolean }>(
          `/api/admin/posts/${encodeURIComponent(originalSlug)}`,
          { method: "PUT", body: JSON.stringify(payload) },
        );
        if (res.ok) {
          api.toast("已提交 GitHub，等待 Vercel 部署。", "success");
          setTimeout(() => {
            // slug 变了 → 跳到新 slug 的编辑页；否则刷新当前页拿新 SHA
            if (res.slug !== originalSlug) {
              window.location.assign(`/admin/posts/${encodeURIComponent(res.slug)}`);
            } else {
              window.location.reload();
            }
          }, 600);
        }
      } catch {
        // toast 已在 apiFetch 中弹出
      } finally {
        submitBtn.removeAttribute("disabled");
        statusText.textContent = "";
      }
    });

    // ====== 删除 ======
    if (deleteBtn) {
      deleteBtn.addEventListener("click", async () => {
        const slug = originalSlugInput.value;
        const sha = existingShaInput.value;
        const ok = window.confirm(`确认删除文章 "${slug}"？\n\n此操作会立即在 GitHub 提交一次删除 commit，不可撤销。`);
        if (!ok) return;
        try {
          await api.fetch(`/api/admin/posts/${encodeURIComponent(slug)}?sha=${encodeURIComponent(sha)}`, { method: "DELETE" });
          api.toast("已提交删除 commit，等待 Vercel 部署。", "success");
          setTimeout(() => window.location.assign("/admin/posts/"), 600);
        } catch {
          // toast 已在 apiFetch 中弹出
        }
      });
    }

    // ====== 发布草稿 / 取消发布 ======
    if (publishBtn) {
      publishBtn.addEventListener("click", async () => {
        const slug = originalSlugInput.value;
        const sha = existingShaInput.value;
        const ok = window.confirm(`确认发布草稿 "${slug}"？\n\n将从 drafts/ 移到 post/，公开站会出现该文章。`);
        if (!ok) return;
        try {
          await api.fetch(`/api/admin/posts/${encodeURIComponent(slug)}/publish`, {
            method: "POST",
            body: JSON.stringify({ existingSha: sha }),
          });
          api.toast("已发布，等待 Vercel 部署。", "success");
          setTimeout(() => window.location.reload(), 600);
        } catch {
          // toast 已在 apiFetch 中弹出
        }
      });
    }
    if (unpublishBtn) {
      unpublishBtn.addEventListener("click", async () => {
        const slug = originalSlugInput.value;
        const ok = window.confirm(`确认把 "${slug}" 移回草稿？\n\n公开站将不再显示该文章。`);
        if (!ok) return;
        try {
          // 复用 PUT 接口，把 status 改为 draft（PUT 内部会触发跨目录 move）
          const payload = {
            ...collectPayload(),
            status: "draft" as const,
          };
          await api.fetch(`/api/admin/posts/${encodeURIComponent(slug)}`, {
            method: "PUT",
            body: JSON.stringify(payload),
          });
          api.toast("已移回草稿，等待 Vercel 部署。", "success");
          setTimeout(() => window.location.reload(), 600);
        } catch {
          // toast 已在 apiFetch 中弹出
        }
      });
    }
  }
</script>
