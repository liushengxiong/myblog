---
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../layouts/admin.astro";
import { getSession } from "../../lib/auth";

// 页面级身份校验（未登录跳登录）
const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname + Astro.url.search);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;
---
<AdminLayout title="仪表盘" username={username} active="dashboard">
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-admin-kpi-grid>
    {
      [
        { label: '博客文章', key: 'posts', desc: '已发布 + 草稿', accent: 'from-indigo-600 to-indigo-500', href: '/admin/posts/' },
        { label: '工具', key: 'tools', desc: '首页工具卡片', accent: 'from-emerald-600 to-emerald-500', href: '/admin/tools/' },
        { label: '项目', key: 'projects', desc: '首页项目卡片', accent: 'from-amber-600 to-amber-500', href: '/admin/projects/' },
        { label: '资源', key: 'resources', desc: '首页资源卡片', accent: 'from-sky-600 to-sky-500', href: '/admin/resources/' },
        { label: '网站设置', key: 'settings', desc: '品牌 / 社交 / SEO', accent: 'from-rose-600 to-rose-500', href: '/admin/settings/' },
        { label: '草稿数', key: 'drafts', desc: '未发布草稿', accent: 'from-violet-600 to-violet-500', href: '/admin/posts/?status=draft' },
      ].map((kpi) => (
        <a
          href={kpi.href}
          class="block rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700 transition-colors"
          data-admin-kpi-card={kpi.key}
        >
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{kpi.label}</div>
              <div class="mt-2 text-2xl font-semibold" data-admin-kpi-value={kpi.key}>–</div>
            </div>
            <span class:list={['h-10 w-10 rounded-xl bg-gradient-to-br opacity-90 shadow-sm', kpi.accent]}></span>
          </div>
          <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">{kpi.desc}</p>
        </a>
      ))
    }
  </div>

  <!-- 最近 commits -->
  <div class="mt-6 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4 dark:border-slate-800">
      <h2 class="text-sm font-semibold">最近提交</h2>
      <span class="text-xs text-slate-400">最多 10 条</span>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-xs text-slate-500 dark:bg-slate-800/60 dark:text-slate-400">
          <tr>
            <th class="px-5 py-3 font-medium">SHA</th>
            <th class="px-5 py-3 font-medium">Message</th>
            <th class="px-5 py-3 font-medium">作者</th>
            <th class="px-5 py-3 font-medium">时间</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-200" data-admin-commits-tbody>
          <tr><td colspan="4" class="px-5 py-6 text-center text-xs text-slate-400">加载中…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="border-b border-slate-100 px-6 py-4 dark:border-slate-800">
      <h2 class="text-sm font-semibold">使用说明</h2>
    </div>
    <ol class="px-6 py-4 space-y-2 text-sm text-slate-600 dark:text-slate-300 list-decimal list-inside">
      <li>后台修改内容会通过 GitHub API 直接写入仓库的 Markdown / JSON 文件。</li>
      <li>每次保存或发布都会形成一条清晰的 Git commit。</li>
      <li>GitHub push 成功后，Vercel 会自动检测并构建部署新站点（通常 30–90 秒）。</li>
      <li>草稿文章会保存到 <code class="text-[12px]">src/content/post/drafts/</code>，并且公开网站三重过滤，不会显示。</li>
      <li>如遇“GitHub 提交失败”，不要重复点击“发布”，请先检查 Token 权限与网络。</li>
    </ol>
  </div>
</AdminLayout>

<script>
  type AdminApi = {
    fetch: <T = unknown>(
      input: RequestInfo,
      init?: RequestInit & { expectCsrf?: boolean },
    ) => Promise<T>;
    toast: (msg: string, level?: "info" | "success" | "error" | "warn") => void;
  };
  const api = (window as unknown as { AdminApi: AdminApi }).AdminApi;

  type DashboardData = {
    posts: { published: number; draft: number; total: number };
    tools: number;
    projects: number;
    resources: number;
    recentCommits: Array<{ sha: string; message: string; date: string; author: string }>;
  };

  function setKpi(key: string, value: string) {
    const el = document.querySelector(`[data-admin-kpi-value="${key}"]`);
    if (el) el.textContent = value;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatDate(iso: string): string {
    if (!iso) return "—";
    try {
      const d = new Date(iso);
      return d.toLocaleString("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
      });
    } catch {
      return iso;
    }
  }

  async function loadDashboard() {
    try {
      const data = await api.fetch<DashboardData>("/api/admin/dashboard");
      setKpi("posts", String(data.posts.total));
      setKpi("drafts", String(data.posts.draft));
      setKpi("tools", String(data.tools));
      setKpi("projects", String(data.projects));
      setKpi("resources", String(data.resources));
      setKpi("settings", "✓");

      const tbody = document.querySelector("[data-admin-commits-tbody]");
      if (!tbody) return;
      if (!data.recentCommits || data.recentCommits.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="px-5 py-6 text-center text-xs text-slate-400">暂无提交记录</td></tr>';
        return;
      }
      tbody.innerHTML = data.recentCommits
        .map((c) => {
          const shortSha = c.sha ? c.sha.slice(0, 7) : "—";
          const firstLine = c.message ? c.message.split("\n")[0] : "(no message)";
          return `<tr>
            <td class="px-5 py-3 font-mono text-xs text-slate-500">${escapeHtml(shortSha)}</td>
            <td class="px-5 py-3">${escapeHtml(firstLine)}</td>
            <td class="px-5 py-3 text-xs text-slate-500">${escapeHtml(c.author || "—")}</td>
            <td class="px-5 py-3 text-xs text-slate-500">${formatDate(c.date)}</td>
          </tr>`;
        })
        .join("");
    } catch {
      const tbody = document.querySelector("[data-admin-commits-tbody]");
      if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="px-5 py-6 text-center text-xs text-red-500">加载失败</td></tr>';
    }
  }

  loadDashboard();
</script>
