---
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../../layouts/admin.astro";
import { getSession } from "../../../lib/auth";
const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;
---
<AdminLayout title="工具管理" username={username} active="tools">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-slate-600 dark:text-slate-300">
      工具列表用于控制首页“工具”卡片。数据存储于 <code>src/content/tools/*.json</code>，Phase 4 接入。
    </p>
    <button
      type="button"
      disabled
      class="inline-flex items-center gap-1 rounded-lg bg-slate-300 px-4 py-3 text-sm font-medium text-slate-700 shadow cursor-not-allowed opacity-80 dark:bg-slate-700 dark:text-slate-200"
    >
      ＋ 新增工具（Phase 4）
    </button>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-10 text-center text-xs text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
    占位页面。Phase 4 实现 CRUD 与拖拽排序。
  </div>
</AdminLayout>
