---
import Button from "../../components/button.astro";
import PostsLoop from "../../components/posts-loop.astro";
import { useTranslations } from "../../i18n/ui.js";
import { getCollection } from "astro:content";
import siteSettings from "../../content/data/site-settings.json";
import Layout from "../../layouts/main.astro";

const lang = "en";
const t = useTranslations(lang);

// Hero：读取 site-settings.json
const hero = siteSettings?.hero;
const heroTitle = hero?.title?.[lang] || t("home.title");
const heroSubtitle = hero?.subtitle?.[lang] || t("home.subtitle");
const heroIntro = hero?.intro?.[lang] || t("home.intro");
const heroPortrait = hero?.portraitImage || "/assets/images/photo.png";
const primaryCta = hero?.primaryCta?.[lang] || t("nav.posts");
const secondaryCta = hero?.secondaryCta?.[lang] || t("nav.about");

// Projects / Resources：从 Content Collection 读取，过滤 visible，按 order 排序
const allProjects = await getCollection("projects");
const projects = allProjects
	.filter((p) => p.data.visible !== false)
	.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
	.slice(0, 3);

const allResources = await getCollection("resources");
const resources = allResources
	.filter((r) => r.data.visible !== false)
	.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
	.slice(0, 3);
---

<Layout description={heroSubtitle}>
  <!-- Hero Section -->
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-1/2">
        <h1
          class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl dark:text-white"
        >
          {heroTitle}
        </h1>
        <p class="mb-4 text-lg font-medium text-neutral-700 dark:text-neutral-300">
          {heroSubtitle}
        </p>
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {heroIntro}
        </p>
        <div class="flex gap-3">
          <Button text={primaryCta} link={`/${lang}/posts/`} />
          <Button text={secondaryCta} link={`/${lang}/about/`} />
        </div>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">
          <div
            class="absolute bottom-0 z-40 w-16 h-16 -translate-x-6 -translate-y-1/2 lg:top-auto top-0 lg:-translate-y-[330px] rounded-full"
          >
            <span
              class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900"
            >
              <span
                class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700"
                >✦</span
              >
            </span>
          </div>
          <div class="relative z-30 px-10">
            <img
              src={heroPortrait}
              alt={heroTitle}
              loading="eager"
              decoding="auto"
              class="relative z-30 w-full aspect-[4/5] md:max-w-md mx-auto rounded-2xl object-cover dark:-translate-y-0.5"
            />
          </div>
          <div
            class="absolute bottom-0 right-0 z-20 w-full h-full lg:h-[420px] translate-x-0 -translate-y-px border border-dashed rounded-2xl bg-gradient-to-r dark:from-neutral-950 dark:via-black dark:to-neutral-950 from-white via-neutral-50 to-white border-neutral-300 dark:border-neutral-700"
          >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Latest Posts Section -->
  <section class="max-w-4xl mx-auto px-7 lg:px-0 mt-20 md:mt-32">
    <div class="flex items-center justify-between mb-8">
      <h2
        class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        {t('home.latestPosts')}
      </h2>
      <a href={`/${lang}/posts/`} class="text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
        {t('home.viewAllPosts')} →
      </a>
    </div>
    <div class="flex flex-col items-stretch w-full gap-5">
      <PostsLoop count="3" lang={lang} />
    </div>
  </section>

  <!-- Projects Section -->
  <section class="max-w-4xl mx-auto px-7 lg:px-0 mt-20 md:mt-32">
    <div class="flex items-center justify-between mb-8">
      <h2
        class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        {t('projects.title')}
      </h2>
      <a href={`/${lang}/projects/`} class="text-sm font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white transition-colors">
        {t('home.viewAllProjects')} →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((entry) => (
        <div class="p-6 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors">
          <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-neutral-900 dark:text-neutral-100">{entry.data.name?.[lang]}</h3>
            <span class="text-xs px-2 py-1 bg-neutral-100 dark:bg-neutral-800 rounded-full text-neutral-600 dark:text-neutral-400">{entry.data.status?.[lang]}</span>
          </div>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4">{entry.data.description?.[lang]}</p>
          <div class="flex flex-wrap gap-2">
            {(entry.data.tags?.[lang] ?? []).map((tag) => (
              <span class="text-xs text-neutral-500 dark:text-neutral-500">#{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Resources Section -->
  <section class="max-w-4xl mx-auto px-7 lg:px-0 mt-20 md:mt-32 mb-20">
    <h2
      class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100 mb-8"
    >
      {t('home.resources')}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {resources.map((entry) => (
        <a href={entry.data.link} class="block p-6 border border-dashed rounded-2xl border-neutral-300 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors group">
          <h3 class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">{entry.data.title?.[lang]}</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-2">{entry.data.description?.[lang]}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
