---
/**
 * 网站设置页（Task 6A.1 / Spec FR-7 / AC-5）
 *
 * 功能：
 *  - 服务端读取 site-settings.json（getFileInfo + SITE_SETTINGS_SCHEMA）
 *  - 5 个分区表单：品牌 / Hero / 社交 / SEO / Footer
 *  - 提交 → PUT /api/admin/settings（携带 existingSha）
 *
 * 设计：singleton JSON，整体替换。SHA 冲突 → 409 提示刷新。
 */
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../../layouts/admin.astro";
import { getSession } from "../../../lib/auth";
import { getFileInfo, PREFIX_SETTINGS, GitHubError } from "../../../lib/github";
import { SITE_SETTINGS_SCHEMA, type SiteSettings } from "../../../lib/schemas";

const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;

const SETTINGS_PATH = `${PREFIX_SETTINGS}site-settings.json`;

let notFound = false;
let serverError = "";
let settings: SiteSettings | null = null;
let sha = "";
let schemaWarning = "";

try {
	const info = await getFileInfo(SETTINGS_PATH);
	if (!info) {
		notFound = true;
	} else {
		sha = info.sha;
		const parsed = SITE_SETTINGS_SCHEMA.safeParse(JSON.parse(info.content));
		if (parsed.success) {
			settings = parsed.data;
		} else {
			// 即使 schema 不合也尝试给原值，便于修复
			schemaWarning = parsed.error.issues
				.map((i) => `${i.path.join(".")}: ${i.message}`)
				.join("; ");
			settings = JSON.parse(info.content) as SiteSettings;
		}
	}
} catch (e) {
	if (e instanceof GitHubError) {
		serverError = e.message;
	} else {
		serverError = e instanceof Error ? e.message : String(e);
	}
}
---

<AdminLayout title="网站设置" username={username} active="settings">
  <nav class="text-xs text-slate-500 dark:text-slate-400">
    <span>系统</span>
    <span class="mx-1">/</span>
    <span class="text-slate-700 dark:text-slate-200">网站设置</span>
  </nav>

  {serverError && (
    <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-xs text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300">
      加载失败：{serverError}
    </div>
  )}

  {notFound && !serverError && (
    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-xs text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
      site-settings.json 不存在。请先在 GitHub 仓库 <code>src/content/data/site-settings.json</code> 创建该文件。
    </div>
  )}

  {schemaWarning && !serverError && (
    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-xs text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
      <div class="font-medium">⚠ 数据校验警告</div>
      <p class="mt-1 break-all">{schemaWarning}</p>
      <p class="mt-1">下方表单仍可编辑并提交以修复数据。</p>
    </div>
  )}

  {settings && (
    <form data-admin-settings-form class="mt-4 space-y-8" autocomplete="off">
      <input type="hidden" data-admin-settings-sha value={sha} />

      <!-- ===== 品牌 ===== -->
      <section class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">品牌信息</h3>
        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">网站名称 / 副标题 / 作者 / Logo 文本 / Favicon</p>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
