          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">Logo 文本（中文）</label>
            <input type="text" data-admin-settings-brand-logo-zh maxlength="60" value={settings.brand.logoText?.zh ?? ""}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">Logo 文本（English）</label>
            <input type="text" data-admin-settings-brand-logo-en maxlength="60" value={settings.brand.logoText?.en ?? ""}
