          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">网站描述（中文）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-brand-desc-zh required maxlength="300" value={settings.brand.siteDescription.zh}
