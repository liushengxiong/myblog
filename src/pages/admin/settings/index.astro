            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">网站标题（中文）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-brand-title-zh required maxlength="200" value={settings.brand.siteTitle.zh}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">网站标题（English）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-brand-title-en required maxlength="200" value={settings.brand.siteTitle.en}
