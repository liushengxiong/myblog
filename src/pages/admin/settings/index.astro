        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">默认标题（中文）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-seo-title-zh required maxlength="120" value={settings.seo.defaultTitle.zh}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">默认标题（English）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-seo-title-en required maxlength="120" value={settings.seo.defaultTitle.en}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">默认描述（中文）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-seo-desc-zh required maxlength="300" value={settings.seo.defaultDescription.zh}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">默认描述（English）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-seo-desc-en required maxlength="300" value={settings.seo.defaultDescription.en}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">关键词（中文）<span class="text-slate-400 font-normal">（英文逗号分隔）</span></label>
            <input type="text" data-admin-settings-seo-kw-zh value={settings.seo.keywords.zh.join(", ")} placeholder="AI, 个人成长"
