          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">OG 兜底图路径</label>
            <div class="flex gap-2">
              <input type="text" data-admin-settings-seo-og maxlength="200" value={settings.seo.ogImage}
                class="flex-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-mono outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
              <button type="button" data-admin-settings-pick-image="data-admin-settings-seo-og"
                class="shrink-0 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">选择图片</button>
            </div>
            <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">建议 1200×630（约 1.91:1）。</p>
          </div>
        </div>
      </section>

      <!-- ===== Footer ===== -->
      <section class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Footer 文案</h3>
        <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">版权声明。<code>{'{year}'}</code> 占位符会被替换为当前年份。</p>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">版权（中文）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-footer-copyright-zh required maxlength="200" value={settings.footer.copyright.zh}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">版权（English）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-footer-copyright-en required maxlength="200" value={settings.footer.copyright.en}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
        </div>
      </section>

      <!-- ===== 操作 ===== -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <button type="submit" data-admin-settings-submit
          class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white shadow hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
          保存设置
        </button>
        <button type="button" data-admin-settings-reload
          class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
          放弃修改并重载
        </button>
        <span data-admin-settings-status class="text-xs text-slate-500 dark:text-slate-400"></span>
      </div>
    </form>
  )}
</AdminLayout>

<script>
  type AdminApi = {
    fetch: <T = unknown>(
      input: RequestInfo,
      init?: RequestInit & { expectCsrf?: boolean },
    ) => Promise<T>;
    toast: (msg: string, level?: "info" | "success" | "error" | "warn") => void;
  };
  const api = (window as unknown as { AdminApi: AdminApi }).AdminApi;

  const form = document.querySelector<HTMLFormElement>("[data-admin-settings-form]");
  if (!form) {
    void null;
  } else {
    const shaInput = form.querySelector<HTMLInputElement>("[data-admin-settings-sha]")!;
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-admin-settings-submit]")!;
    const reloadBtn = form.querySelector<HTMLButtonElement>("[data-admin-settings-reload]")!;
    const statusText = form.querySelector<HTMLElement>("[data-admin-settings-status]")!;

    function val(sel: string): string {
      const el = form!.querySelector<HTMLInputElement | HTMLTextAreaElement>(sel);
      return el?.value ?? "";
    }

    function buildPayload() {
      const brand = {
        siteTitle: { zh: val("[data-admin-settings-brand-title-zh]"), en: val("[data-admin-settings-brand-title-en]") },
        siteDescription: { zh: val("[data-admin-settings-brand-desc-zh]"), en: val("[data-admin-settings-brand-desc-en]") },
        siteAuthor: { zh: val("[data-admin-settings-brand-author-zh]"), en: val("[data-admin-settings-brand-author-en]") },
        logoText: { zh: val("[data-admin-settings-brand-logo-zh]"), en: val("[data-admin-settings-brand-logo-en]") },
        logoImage: val("[data-admin-settings-brand-logo-image]"),
        favicon: val("[data-admin-settings-brand-favicon]"),
      };
      const hero = {
        title: { zh: val("[data-admin-settings-hero-title-zh]"), en: val("[data-admin-settings-hero-title-en]") },
        subtitle: { zh: val("[data-admin-settings-hero-subtitle-zh]"), en: val("[data-admin-settings-hero-subtitle-en]") },
        intro: { zh: val("[data-admin-settings-hero-intro-zh]"), en: val("[data-admin-settings-hero-intro-en]") },
        portraitImage: val("[data-admin-settings-hero-portrait]"),
        primaryCta: { zh: val("[data-admin-settings-hero-cta1-zh]"), en: val("[data-admin-settings-hero-cta1-en]") },
        secondaryCta: { zh: val("[data-admin-settings-hero-cta2-zh]"), en: val("[data-admin-settings-hero-cta2-en]") },
      };
      const social = {
        github: val("[data-admin-settings-social-github]"),
        email: val("[data-admin-settings-social-email]"),
        wechat: val("[data-admin-settings-social-wechat]"),
        twitter: val("[data-admin-settings-social-twitter]"),
        linkedin: val("[data-admin-settings-social-linkedin]"),
      };
      const seo = {
        defaultTitle: { zh: val("[data-admin-settings-seo-title-zh]"), en: val("[data-admin-settings-seo-title-en]") },
        defaultDescription: { zh: val("[data-admin-settings-seo-desc-zh]"), en: val("[data-admin-settings-seo-desc-en]") },
        keywords: {
          zh: val("[data-admin-settings-seo-kw-zh]").split(/[,，]/).map((s) => s.trim()).filter(Boolean),
          en: val("[data-admin-settings-seo-kw-en]").split(/[,，]/).map((s) => s.trim()).filter(Boolean),
        },
        ogImage: val("[data-admin-settings-seo-og]"),
      };
      const footer = {
        copyright: {
          zh: val("[data-admin-settings-footer-copyright-zh]"),
          en: val("[data-admin-settings-footer-copyright-en]"),
        },
      };
      return { brand, hero, social, seo, footer };
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const payload = buildPayload();
      submitBtn.setAttribute("disabled", "true");
      statusText.textContent = "正在提交到 GitHub…";
      try {
        const res = await api.fetch<{ ok: boolean; sha: string }>("/api/admin/settings", {
          method: "PUT",
          body: JSON.stringify({ data: payload, existingSha: shaInput.value }),
        });
        if (res.ok) {
          api.toast("已提交 GitHub，等待 Vercel 部署。", "success");
          shaInput.value = res.sha;
          // 刷新页面以获取新 sha 并展示最新值
          setTimeout(() => window.location.reload(), 600);
        }
      } catch {
        // toast 已在 apiFetch 中弹出
      } finally {
        submitBtn.removeAttribute("disabled");
        statusText.textContent = "";
      }
    });

    reloadBtn.addEventListener("click", () => {
      if (window.confirm("放弃当前修改并重新加载？")) {
        window.location.reload();
      }
    });

    // ====== 图片选择器（4 个图片字段共享） ======
    const pickButtons = form.querySelectorAll<HTMLButtonElement>("[data-admin-settings-pick-image]");
    for (const btn of pickButtons) {
      btn.addEventListener("click", async () => {
        const targetSel = btn.getAttribute("data-admin-settings-pick-image");
        if (!targetSel) return;
        const targetInput = form.querySelector<HTMLInputElement>(`[${targetSel}]`);
        if (!targetInput) return;
        const { openImagePicker } = await import("../../../lib/image-picker");
        openImagePicker({
          title: "选择图片",
          confirmText: "使用此图片",
          onPick: (url) => {
            targetInput.value = url;
            targetInput.focus();
            targetInput.dispatchEvent(new Event("input"));
            api.toast(`已填入图片：${url}`, "success");
          },
        });
      });
    }
  }
</script>
