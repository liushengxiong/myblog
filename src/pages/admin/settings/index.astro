            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">微信（二维码图片路径或文字）</label>
            <div class="flex gap-2">
              <input type="text" data-admin-settings-social-wechat maxlength="200" value={settings.social.wechat} placeholder="/assets/images/wechat-qr.png"
