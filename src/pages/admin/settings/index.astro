---
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../../layouts/admin.astro";
import { getSession } from "../../../lib/auth";
const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;
---
<AdminLayout title="网站设置" username={username} active="settings">
  <div class="grid gap-6 lg:grid-cols-2">
    {[
      { t: '品牌信息', d: '网站名称 / 副标题 / Logo / Favicon', status: 'Phase 6 接入' },
      { t: '首页 Hero', d: '标题 / 副标题 / CTA 按钮（中英文）', status: 'Phase 6 接入' },
      { t: '社交链接', d: 'GitHub / Email / 微信 等', status: 'Phase 6 接入' },
      { t: 'SEO', d: 'Default Title / Description / Keywords / OG 兜底', status: 'Phase 6 接入' },
      { t: 'Footer 文案', d: '版权声明 / 建站说明等', status: 'Phase 6 接入' },
      { t: '缓存 & 部署', d: '此处不做：通过 Vercel 与 GitHub 自动部署处理', status: '不接入' },
    ].map((s) => (
      <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-sm font-semibold">{s.t}</h3>
            <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{s.d}</p>
          </div>
          <span
            class:list={[
              'inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium',
              s.status === '不接入'
                ? 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300'
                : 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200',
            ]}
          >
            {s.status}
          </span>
        </div>
      </div>
    ))}
  </div>
</AdminLayout>
