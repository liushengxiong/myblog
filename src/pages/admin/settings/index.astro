          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">网站描述（English）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-brand-desc-en required maxlength="300" value={settings.brand.siteDescription.en}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">作者（中文）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-brand-author-zh required maxlength="120" value={settings.brand.siteAuthor.zh}
              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">作者（English）<span class="text-red-600">*</span></label>
            <input type="text" data-admin-settings-brand-author-en required maxlength="120" value={settings.brand.siteAuthor.en}
