              class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">次按钮文案（English）</label>
            <input type="text" data-admin-settings-hero-cta2-en maxlength="40" value={settings.hero.secondaryCta?.en ?? ""}
