---
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../layouts/admin.astro";
import { getSession } from "../../lib/auth";

// 页面级身份校验（未登录跳登录）
const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname + Astro.url.search);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;
---
<AdminLayout title="仪表盘" username={username} active="dashboard">
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {
      [
        { label: '博客文章', value: '–', desc: '发布 + 草稿', accent: 'from-indigo-600 to-indigo-500' },
        { label: '工具', value: '–', desc: '首页工具卡片', accent: 'from-emerald-600 to-emerald-500' },
        { label: '项目', value: '–', desc: '首页项目卡片', accent: 'from-amber-600 to-amber-500' },
        { label: '资源', value: '–', desc: '首页资源卡片', accent: 'from-sky-600 to-sky-500' },
        { label: '网站设置', value: '待接入', desc: '品牌/社交/SEO', accent: 'from-rose-600 to-rose-500' },
        { label: '最近修改', value: '待接入', desc: '通过 GitHub API 读取', accent: 'from-violet-600 to-violet-500' },
      ].map((kpi) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <div class="flex items-center justify-between">
            <div>
              <div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{kpi.label}</div>
              <div class="mt-2 text-2xl font-semibold">{kpi.value}</div>
            </div>
            <span class:list={['h-10 w-10 rounded-xl bg-gradient-to-br opacity-90 shadow-sm', kpi.accent]}></span>
          </div>
          <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">{kpi.desc}</p>
        </div>
      ))
    }
  </div>

  <div class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="border-b border-slate-100 px-6 py-4 dark:border-slate-800">
      <h2 class="text-sm font-semibold">使用说明</h2>
    </div>
    <ol class="px-6 py-4 space-y-2 text-sm text-slate-600 dark:text-slate-300 list-decimal list-inside">
      <li>后台修改内容会通过 GitHub API 直接写入仓库的 Markdown / JSON 文件。</li>
      <li>每次保存或发布都会形成一条清晰的 Git commit。</li>
      <li>GitHub push 成功后，Vercel 会自动检测并构建部署新站点（通常 30–90 秒）。</li>
      <li>草稿文章会保存到 <code class="text-[12px]">src/content/post/drafts/</code>，并且公开网站三重过滤，不会显示。</li>
      <li>如遇“GitHub 提交失败”，不要重复点击“发布”，请先检查 Token 权限与网络。</li>
    </ol>
  </div>
</AdminLayout>
