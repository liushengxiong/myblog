---
/**
 * 编辑项目页（Task 5A.1b / Spec FR-6 / AC-5 / AC-6）
 *
 * 功能：
 *  - 服务端读取项目（findDataItem + PROJECT_SCHEMA），表单预填
 *  - id 字段默认可编辑但带警告：修改 id 会改变文件路径（API 支持原子 move）
 *  - 提交 → PUT /api/admin/projects/[id]（携带 existingSha）
 *  - 删除按钮（二次确认）
 *
 * 与 tools/[id].astro 同构，差异：
 *  - 多 status 双语字段（zh/en）
 *  - 无 url / featured 字段
 */
export const prerender = false;
import type { APIContext } from "astro";
import AdminLayout from "../../../layouts/admin.astro";
import { getSession } from "../../../lib/auth";
import { findDataItem } from "../../../lib/data-items";
import { PREFIX_PROJECTS, GitHubError } from "../../../lib/github";
import { PROJECT_SCHEMA, type Project } from "../../../lib/schemas";

const session = await getSession(Astro as unknown as APIContext);
if (!session) {
	const redir = encodeURIComponent(Astro.url.pathname + Astro.url.search);
	return Astro.redirect(`/admin/login?redirect=${redir}`);
}
const username = session.username;

const id = Astro.params.id ?? "";
let notFound = false;
let serverError = "";
let project: Project | null = null;
let sha = "";

if (id) {
	try {
		const found = await findDataItem<Project>(PREFIX_PROJECTS, id, { schema: PROJECT_SCHEMA });
		if (!found) {
			notFound = true;
		} else {
			project = found.data;
			sha = found.sha;
		}
	} catch (e) {
		if (e instanceof GitHubError) {
			serverError = e.message;
		} else {
			serverError = e instanceof Error ? e.message : String(e);
		}
	}
} else {
	notFound = true;
}

const initial = project
	? {
			id,
			name_zh: project.name?.zh ?? "",
			name_en: project.name?.en ?? "",
			desc_zh: project.description?.zh ?? "",
			desc_en: project.description?.en ?? "",
			status_zh: project.status?.zh ?? "",
			status_en: project.status?.en ?? "",
			image: project.image ?? "",
			tags_zh: (project.tags?.zh ?? []).join(", "),
			tags_en: (project.tags?.en ?? []).join(", "),
			visible: project.visible !== false,
			order: project.order ?? 0,
			sha,
		}
	: null;
---

<AdminLayout title={`编辑项目：${id || "—"}`} username={username} active="projects">
  <nav class="text-xs text-slate-500 dark:text-slate-400">
    <a href="/admin/projects/" class="hover:text-slate-700 dark:hover:text-slate-200">项目管理</a>
    <span class="mx-1">/</span>
    <span class="text-slate-700 dark:text-slate-200">{id || "未找到"}</span>
  </nav>

  {serverError && (
    <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-xs text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300">
      加载失败：{serverError}
    </div>
  )}

  {notFound && !serverError && (
    <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-xs text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
      未找到 id 为 <code>{id}</code> 的项目。请<a href="/admin/projects/" class="underline">返回列表</a>。
    </div>
  )}

  {initial && (
    <form data-admin-project-form class="mt-4 space-y-5" autocomplete="off">
      <input type="hidden" data-admin-project-existing-sha value={sha} />
      <input type="hidden" data-admin-project-old-id value={id} />

      <!-- ID（可改，带警告） -->
      <div>
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
          ID <span class="text-red-600">*</span>
          <span class="ml-1 text-slate-400 font-normal">（修改 id 会重命名文件）</span>
        </label>
        <input
          type="text"
          name="id"
          data-admin-project-id
          required
          pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
          minlength="2"
          maxlength="120"
          value={initial.id}
          class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-mono outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
        />
        <p data-admin-project-id-hint class="mt-1 text-xs text-amber-600 dark:text-amber-400">
          ⚠ 修改 id 会改变文件路径（旧文件删除 + 新文件创建，同一次 commit）。
        </p>
      </div>

      <!-- 名称 中/英 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            名称（中文） <span class="text-red-600">*</span>
          </label>
          <input
            type="text"
            name="name_zh"
            data-admin-project-name-zh
            required
            maxlength="200"
            value={initial.name_zh}
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            名称（English） <span class="text-red-600">*</span>
          </label>
          <input
            type="text"
            name="name_en"
            data-admin-project-name-en
            required
            maxlength="200"
            value={initial.name_en}
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
      </div>

      <!-- 描述 中/英 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            描述（中文） <span class="text-red-600">*</span>
          </label>
          <textarea
            name="desc_zh"
            data-admin-project-desc-zh
            required
            rows="3"
            maxlength="500"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          >{initial.desc_zh}</textarea>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            描述（English） <span class="text-red-600">*</span>
          </label>
          <textarea
            name="desc_en"
            data-admin-project-desc-en
            required
            rows="3"
            maxlength="500"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          >{initial.desc_en}</textarea>
        </div>
      </div>

      <!-- 状态 中/英 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            状态（中文） <span class="text-red-600">*</span>
            <span class="ml-1 text-slate-400 font-normal">（如：进行中 / 已完成 / 暂停）</span>
          </label>
          <input
            type="text"
            name="status_zh"
            data-admin-project-status-zh
            required
            maxlength="100"
            value={initial.status_zh}
            placeholder="进行中"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            状态（English） <span class="text-red-600">*</span>
            <span class="ml-1 text-slate-400 font-normal">（如：In Progress / Completed）</span>
          </label>
          <input
            type="text"
            name="status_en"
            data-admin-project-status-en
            required
            maxlength="100"
            value={initial.status_en}
            placeholder="In Progress"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
      </div>

      <!-- 图片 -->
      <div>
        <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
          图片路径 <span class="text-slate-400 font-normal">（可留空）</span>
        </label>
        <input
          type="text"
          name="image"
          data-admin-project-image
          value={initial.image}
          placeholder="/assets/images/projects/xxx.png"
          class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-mono outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
        />
      </div>

      <!-- 标签 中/英 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            标签（中文） <span class="text-slate-400 font-normal">（英文逗号分隔）</span>
          </label>
          <input
            type="text"
            name="tags_zh"
            data-admin-project-tags-zh
            value={initial.tags_zh}
            placeholder="AI, 自动化"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            标签（English） <span class="text-slate-400 font-normal">（逗号分隔）</span>
          </label>
          <input
            type="text"
            name="tags_en"
            data-admin-project-tags-en
            value={initial.tags_en}
            placeholder="AI, Automation"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
      </div>

      <!-- 排序 + 可见 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-200 mb-1.5">
            排序 <span class="text-slate-400 font-normal">（数字越小越靠前）</span>
          </label>
          <input
            type="number"
            name="order"
            data-admin-project-order
            value={initial.order}
            min="0"
            step="1"
            class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-slate-400 dark:border-slate-700 dark:bg-slate-900"
          />
        </div>
        <label class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-200 self-end pb-2">
          <input
            type="checkbox"
            name="visible"
            data-admin-project-visible
            checked={initial.visible}
            class="rounded border-slate-300 text-slate-900 focus:ring-slate-500 dark:border-slate-600 dark:bg-slate-900"
          />
          <span>显示（前台可见）</span>
        </label>
      </div>

      <!-- 操作 -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <button
          type="submit"
          data-admin-project-submit
          class="inline-flex items-center gap-1 rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white shadow hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
        >
          保存修改
        </button>
        <a
          href="/admin/projects/"
          class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
        >
          返回列表
        </a>
        <button
          type="button"
          data-admin-project-delete
          class="inline-flex items-center rounded-lg border border-red-200 bg-white px-4 py-2.5 text-sm text-red-700 hover:bg-red-50 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300 dark:hover:bg-red-900/40"
        >
          删除项目
        </button>
        <span data-admin-project-status-text class="text-xs text-slate-500 dark:text-slate-400"></span>
      </div>
    </form>
  )}
</AdminLayout>

<script>
  type AdminApi = {
    fetch: <T = unknown>(
      input: RequestInfo,
      init?: RequestInit & { expectCsrf?: boolean },
    ) => Promise<T>;
    toast: (msg: string, level?: "info" | "success" | "error" | "warn") => void;
  };
  const api = (window as unknown as { AdminApi: AdminApi }).AdminApi;

  const form = document.querySelector<HTMLFormElement>("[data-admin-project-form]");
  if (!form) {
    // 占位以保持模块结构（页面无表单时不绑定事件）
    void null;
  } else {
    const idInput = form.querySelector<HTMLInputElement>("[data-admin-project-id]")!;
    const idHint = form.querySelector<HTMLElement>("[data-admin-project-id-hint]")!;
    const oldIdInput = form.querySelector<HTMLInputElement>("[data-admin-project-old-id]")!;
    const shaInput = form.querySelector<HTMLInputElement>("[data-admin-project-existing-sha]")!;
    const nameZhInput = form.querySelector<HTMLInputElement>("[data-admin-project-name-zh]")!;
    const nameEnInput = form.querySelector<HTMLInputElement>("[data-admin-project-name-en]")!;
    const descZhInput = form.querySelector<HTMLTextAreaElement>("[data-admin-project-desc-zh]")!;
    const descEnInput = form.querySelector<HTMLTextAreaElement>("[data-admin-project-desc-en]")!;
    const statusZhInput = form.querySelector<HTMLInputElement>("[data-admin-project-status-zh]")!;
    const statusEnInput = form.querySelector<HTMLInputElement>("[data-admin-project-status-en]")!;
    const imageInput = form.querySelector<HTMLInputElement>("[data-admin-project-image]")!;
    const tagsZhInput = form.querySelector<HTMLInputElement>("[data-admin-project-tags-zh]")!;
    const tagsEnInput = form.querySelector<HTMLInputElement>("[data-admin-project-tags-en]")!;
    const orderInput = form.querySelector<HTMLInputElement>("[data-admin-project-order]")!;
    const visibleInput = form.querySelector<HTMLInputElement>("[data-admin-project-visible]")!;
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-admin-project-submit]")!;
    const statusText = form.querySelector<HTMLElement>("[data-admin-project-status-text]")!;
    const deleteBtn = document.querySelector<HTMLButtonElement>("[data-admin-project-delete]");

    const SLUG_REGEX = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
    const oldId = oldIdInput.value;

    idInput.addEventListener("input", () => {
      const v = idInput.value.trim();
      if (!v) {
        idHint.textContent = "id 不能为空。";
        idHint.className = "mt-1 text-xs text-red-600 dark:text-red-400";
        return;
      }
      if (!SLUG_REGEX.test(v) || v.length < 2 || v.length > 120) {
        idHint.textContent = "id 格式非法：仅小写字母/数字/连字符，2-120 字符。";
        idHint.className = "mt-1 text-xs text-red-600 dark:text-red-400";
        return;
      }
      if (v !== oldId) {
        idHint.textContent = `⚠ 将重命名文件：${oldId}.json → ${v}.json（同一次 commit 删除旧文件 + 创建新文件）。`;
        idHint.className = "mt-1 text-xs text-amber-600 dark:text-amber-400";
      } else {
        idHint.textContent = "id 未变更。";
        idHint.className = "mt-1 text-xs text-slate-500 dark:text-slate-400";
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const newId = idInput.value.trim();
      if (!SLUG_REGEX.test(newId) || newId.length < 2) {
        api.toast("id 格式非法，请检查。", "warn");
        idInput.focus();
        return;
      }
      if (
        !nameZhInput.value.trim() || !nameEnInput.value.trim()
        || !descZhInput.value.trim() || !descEnInput.value.trim()
        || !statusZhInput.value.trim() || !statusEnInput.value.trim()
      ) {
        api.toast("请填写所有必填字段。", "warn");
        return;
      }
      const tagsZh = tagsZhInput.value.split(/[,，]/).map((s) => s.trim()).filter(Boolean);
      const tagsEn = tagsEnInput.value.split(/[,，]/).map((s) => s.trim()).filter(Boolean);
      const order = Math.max(0, Math.floor(Number(orderInput.value) || 0));
      const payload = {
        data: {
          id: newId,
          name: { zh: nameZhInput.value.trim(), en: nameEnInput.value.trim() },
          description: { zh: descZhInput.value.trim(), en: descEnInput.value.trim() },
          status: { zh: statusZhInput.value.trim(), en: statusEnInput.value.trim() },
          image: imageInput.value.trim(),
          tags: { zh: tagsZh, en: tagsEn },
          visible: visibleInput.checked,
          order,
        },
        existingSha: shaInput.value,
      };
      submitBtn.setAttribute("disabled", "true");
      statusText.textContent = "正在提交到 GitHub…";
      try {
        const res = await api.fetch<{ ok: boolean; id: string; moved: boolean }>(
          `/api/admin/projects/${encodeURIComponent(oldId)}`,
          { method: "PUT", body: JSON.stringify(payload) },
        );
        if (res.ok) {
          api.toast("已提交 GitHub，等待 Vercel 部署。", "success");
          setTimeout(() => {
            // 若 id 变更，跳到新路径；否则刷新当前页
            if (res.moved && res.id !== oldId) {
              window.location.assign(`/admin/projects/${encodeURIComponent(res.id)}`);
            } else {
              window.location.reload();
            }
          }, 600);
        }
      } catch {
        // toast 已在 apiFetch 中弹出
      } finally {
        submitBtn.removeAttribute("disabled");
        statusText.textContent = "";
      }
    });

    deleteBtn?.addEventListener("click", async () => {
      const ok = window.confirm(`确认删除项目 "${oldId}"？\n\n此操作会立即在 GitHub 提交一次删除 commit，不可撤销。`);
      if (!ok) return;
      try {
        await api.fetch(`/api/admin/projects/${encodeURIComponent(oldId)}?sha=${encodeURIComponent(shaInput.value)}`, { method: "DELETE" });
        api.toast("已提交删除 commit，等待 Vercel 部署。", "success");
        setTimeout(() => window.location.assign("/admin/projects/"), 500);
      } catch {
        // toast 已在 apiFetch 中弹出
      }
    });
  }
</script>
